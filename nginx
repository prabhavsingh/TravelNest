# nginx.conf

user nginx;
worker_processes auto

error_log /var/log/nginx/error.log

events{
    worker_connections 1024;
}

http {
    server {
        listen 80;
        server_name localhost;
        # server_name mydomain.com www.mydomain.com;
        return 301 https://$host$request_url; # redirect to this host
    }

# this is the host request is being redirected to
    server {
        listen 443 ssl;
        server_name mydomain.com www.mydomain.com;


        # ssl configuration

        ssl_certificate /path/to/your/ssl_certificate.crt;
        ssl_certificate_key /path/to/your/ssl_private_key.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        ssl_prefer_server_ciphers on;
        ssl_stapling on;
        ssl_stapling_verify on;

        ssl_trusted_certificate /path/to/your/ca_certificate.crt;

        root /usr/share/nginx/html;

        # Buffering and caching settings

        proxy_buffering on;
        proxy_buffer_size 8;
        proxy_buffers 2048 8k;
        proxy_busy_buffers_size 16k;

        proxy_cache_valid 200 1h;


        # load balancing
        upstream backend_servers {
            server backend_servers1 ip:port;
            server backend_servers2 ip:port;

        # Addddd more servers as needed
            # server backend_servers3 ip:port;
        }

        
        location / {
            proxy_pass http://backend_servers;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_redirect off;

            error_page 500 502 503 504 /error.html;
            location = /error.html {
                root /path/to/your/error/pages;
                internal;
            }
        }

        # gzip compression
        gzip on;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss;
        gzip_proxied any;
        gzip_vary on;


        # cahcing static content
        location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg)$ {
            expires 30d; # adjust the cahcing duration as needed
            add_header Cache-Control "public, no-transform, max-age=2592000"; # adjust cache control as needed
        }

        access_log /var/log/nginx/access.log;
        error_log /var/log/nginx/error.log;
    }
}