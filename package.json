{
  "name": "travelnest",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "tsx watch src/server.ts",
    "start:prod": "SET NODE_ENV=production & nodemon server.js ",
    "watch": "parcel watch ./public/js/index.js --dist-dir ./public/dist --no-source-maps",
    "build": "parcel build ./public/js/index.js --dist-dir ./public/dist --no-source-maps",
    "build:ts": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prabhavsingh/NodeTourGuide.git"
  },
  "author": "Prabhav Kumar Singh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/prabhavsingh/NodeTourGuide/issues"
  },
  "homepage": "https://github.com/prabhavsingh/NodeTourGuide#readme",
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "core-js": "^3.49.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pug": "^3.0.4",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "stripe": "^22.1.1",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.7.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "nodemon": "^3.1.14",
    "parcel": "^2.16.4",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
