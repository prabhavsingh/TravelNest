{
  "name": "travelnest",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "type": "module",
  "targets": {
    "main": false,
    "default": {
      "context": "browser"
    }
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "tsx --watch src/server.ts",
    "worker": "nodemon src/utils/workers.js",
    "start:prod": "SET NODE_ENV=production & nodemon server.js ",
    "watch": "parcel watch ./public/js/index.js --dist-dir ./public/dist --no-source-maps",
    "build": "parcel build ./public/js/index.js --dist-dir ./public/dist --no-source-maps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prabhavsingh/NodeTourGuide.git"
  },
  "author": "Prabhav Kumar Singh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/prabhavsingh/NodeTourGuide/issues"
  },
  "homepage": "https://github.com/prabhavsingh/NodeTourGuide#readme",
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.10",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.3.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.4",
    "parcel": "^2.16.4",
    "prom-client": "^15.1.3",
    "pug": "^3.0.3",
    "response-time": "^2.3.4",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "stripe": "^17.7.0",
    "validator": "^13.9.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.7.0",
    "@types/nodemailer": "^8.0.0",
    "@types/response-time": "^2.3.9",
    "@types/validator": "^13.15.10",
    "buffer": "^6.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
