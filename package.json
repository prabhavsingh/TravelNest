{
  "name": "travelnest",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:prod": "SET NODE_ENV=production & nodemon server.js ",
    "watch": "parcel watch ./public/js/index.js --out-dir ./public/dist --out-file bundle.js --no-source-maps",
    "build": "parcel build ./public/js/index.js --out-dir ./public/dist --out-file bundle.js --no-source-maps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prabhavsingh/NodeTourGuide.git"
  },
  "author": "Prabhav Kumar Singh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/prabhavsingh/NodeTourGuide/issues"
  },
  "homepage": "https://github.com/prabhavsingh/NodeTourGuide#readme",
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.3.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.4",
    "pug": "^3.0.3",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "stripe": "^17.7.0",
    "validator": "^13.9.0",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
